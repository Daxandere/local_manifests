<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the Redmi Note 14 Pro+ 5G (amethyst), LineageOS 23.2.

  Clone this repository into $SRC/.repo/local_manifests, or copy this file
  there.

  The device tree lives in this repository:
      https://github.com/Daxandere/android_device_xiaomi_amethyst

  The kernel and hardware/xiaomi repositories stay on the amethyst-playground
  organisation until they are forked; the vendor repository is already forked
  and lives under the "mine" remote. When you fork another one, change its
  `remote` from "upstream" to "mine".

  The Qualcomm pieces are NOT listed here on purpose: LineageOS already
  provides them in snippets/lineage.xml, including
      device/qcom/sepolicy_vndr/sm8650   (lineage-23.2-caf-sm8650)
      hardware/qcom-caf/sm8650           (audio, display, data-ipa)
      hardware/qcom-caf/common           (creates device/qcom/sepolicy_vndr/SEPolicy.mk)
      vendor/qcom/opensource/*           (core-utils-vendor, power, display, ...)
  Adding any of them again makes `repo` abort with "duplicate path".

  This manifest uses HTTPS, which works without SSH keys on a fresh build
  server. If you prefer SSH, change the "mine" fetch value to
  git@github.com:Daxandere (repo also accepts the ssh:// form).
-->
<manifest>
  <remote name="upstream" fetch="https://github.com/amethyst-playground" />
  <remote name="mine"     fetch="https://github.com/Daxandere" />

  <project name="android_device_xiaomi_amethyst"
           path="device/xiaomi/amethyst"
           remote="mine"
           revision="lineage-23.2" />

  <project name="android_device_xiaomi_amethyst-kernel"
           path="device/xiaomi/amethyst-kernel"
           remote="upstream"
           revision="lineage-23.2" />

  <project name="proprietary_vendor_xiaomi_amethyst"
           path="vendor/xiaomi/amethyst"
           remote="mine"
           revision="lineage-23.2" />

  <project name="android_hardware_xiaomi"
           path="hardware/xiaomi"
           remote="upstream"
           revision="lineage-23.2" />
</manifest>
